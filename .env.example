# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=vaulta

# Random string, at least 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Demo money: new accounts start with this balance and can top up via /api/funds.
# Set ALLOW_DEMO_FUNDING=false once real payments exist.
DEMO_STARTING_BALANCE=12500
ALLOW_DEMO_FUNDING=true
